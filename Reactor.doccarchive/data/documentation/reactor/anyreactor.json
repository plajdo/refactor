":"text","text":"Behavior:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"State is accessed dynamically and mutated by reducing events on a concrete underlying reactor."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lifecycle: "},{"type":"codeVoice","code":"AnyReactor"},{"type":"text","text":" does not automatically start the wrapped reactor."},{"type":"text","text":" "},{"type":"text","text":"Call "},{"type":"codeVoice","code":"start()"},{"type":"text","text":" explicitly to initialize external subscriptions."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Events from "},{"type":"codeVoice","code":"send(action:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"send(action:) async"},{"type":"text","text":", and "},{"type":"codeVoice","code":"send(destination:)"},{"type":"text","text":" are forwarded to the base reactor."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Example:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ProfileView: View {","    @ViewModel var reactor: AnyReactor = ProfileViewModel().eraseToAnyReactor()","","    var body: some View {","        VStack {","            Text(reactor.name)              \/\/ dynamic access into state","            if reactor.isLoading { ProgressView() }","            Button(\"Reload\") { reactor.send(action: .reload) }","        }","    }","}"],"type":"codeListing"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"Mutation type is intentionally erased. If you need access to mutations, prefer using concrete Reactor type instead."}],"type":"paragraph"}],"type":"aside"}]}],"references":{"doc://refactor.Reactor/documentation/Reactor/AnyReactor/Equatable-Implementations":{"kind":"article","abstract":[],"title":"Equatable Implementations","identifier":"doc:\/\/refactor.Reactor\/documentation\/Reactor\/AnyReactor\/Equatable-Implementat